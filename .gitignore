# Secrets: never commit real env files or Rails keys
.env
.env.*
!.env.example
backend/config/master.key
backend/config/credentials/*.key
# Deploy target and SSH keys (deploy/deploy.env.example is the template)
deploy/deploy.env
*.pem
deploy/log/

# Ruby / Rails
backend/log/*
backend/tmp/*
!backend/log/.keep
!backend/tmp/.keep
backend/storage/*
backend/coverage/
# Built React app copied in for production-mode runs (the Docker image builds its own)
backend/frontend/
backend/public/assets/
backend/vendor/bundle/
backend/.bundle/

# Node / Vite
frontend/node_modules/
frontend/dist/
frontend/coverage/
*.local
npm-debug.log*

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.sw?
