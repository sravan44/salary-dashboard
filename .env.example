# Copy to .env and adjust. Placeholders only — never commit real values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-locally
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-locally
RAILS_MAX_THREADS=5
# Optional for docker compose (local defaults exist). Required in real deployments: openssl rand -hex 64
SECRET_KEY_BASE=replace-with-a-long-random-string
# Demo sign-ins (admin@, hr@, viewer@acme.example; see README). Outside production they default to the
# README password. In production they are created ONLY when this is set; leave it unset in real deployments
# and create users with: bin/rails users:create EMAIL=... ROLES=... PASSWORD=...
DEMO_USER_PASSWORD=change-me-locally
