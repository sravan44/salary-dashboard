# Copy to deploy/deploy.env (git-ignored) and fill in. Read by `cap production …`;
# a variable set in your shell overrides the file, e.g. DEPLOY_HOST=… bundle exec cap production deploy
#
# No AWS/IAM access keys are needed or wanted here: Capistrano only connects over SSH with the instance's key pair.

# The instance's Elastic IP (EC2 → Elastic IPs), e.g. 13.200.10.20
DEPLOY_HOST=
# Ubuntu AMIs log in as "ubuntu"
DEPLOY_USER=ubuntu
# The key pair file downloaded when the instance was created (chmod 600); keep it outside the repository
DEPLOY_KEY=~/.ssh/salary-dashboard.pem
# Branch to deploy
BRANCH=main
